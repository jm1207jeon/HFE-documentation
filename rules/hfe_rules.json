      "params": { "max": 5 },
      "message": "폰트 크기 {measured}단계 — 계층 과다", "recommendation": "L1~L5 표준 계층으로 정리.", "ref": "§3.1.2" },
    { "id": "C2-04", "category": "C2", "appliesTo": "Both", "severity": "Major", "highlightOnPass": true,
