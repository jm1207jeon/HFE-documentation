    { "id": "C1-02", "category": "C1", "appliesTo": "Both", "severity": "Major",
      "title": "대형 텍스트 대비율", "check": "largeTextContrast",
      "params": { "minRatio": 3.0 },
      "message": "대형 텍스트 대비율 {measured}:1 — 기준 {target}:1 미달", "recommendation": "대형 텍스트도 3:1 이상 확보 필요.", "ref": "WCAG 2.2 SC 1.4.3" },
    { "id": "C1-03", "category": "C1", "appliesTo": "Screen", "severity": "Major",
      "title": "비텍스트(테두리·아이콘) 대비율", "check": "nonTextContrast",
