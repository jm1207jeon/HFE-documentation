    { "id": "C2-06", "category": "C2", "appliesTo": "Both", "severity": "Minor",
      "title": "제목 크기 위계", "check": "titleHierarchy",
      "params": { "headerMinPt": 14, "headerMinPx": 18 },
      "message": "제목({measured})이 본문과 위계 차이 부족", "recommendation": "문서 제목 14pt+/화면 타이틀 18px+ Bold.", "ref": "§3.1.2" },

    { "id": "C3-01", "category": "C3", "appliesTo": "Both", "severity": "Major",
