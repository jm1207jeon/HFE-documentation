    { "id": "C1-06", "category": "C1", "appliesTo": "Both", "severity": "Major",
      "title": "적·녹 단독 병치 구분 금지", "check": "redGreenAdjacency",
      "params": { "maxDistanceMm": 10, "maxDistancePx": 40 },
      "message": "색상만으로 구분되는 적/녹 요소가 인접({measured}) 배치됨", "recommendation": "위치·형태·라벨 차이를 병행하십시오.", "ref": "색각 접근성 / §3.2.2" },
    { "id": "C1-07", "category": "C1", "appliesTo": "Both", "severity": "Minor",
      "title": "비표준 의미색 사용", "check": "paletteCompliance",
      "params": { "allowedSemanticColors": ["#2E7D32", "#EAF4EB", "#C62828", "#FDECEA", "#B45309", "#E65100", "#FFF8E1", "#1565C0", "#0D47A1", "#E8F1FB"] },
      "message": "팔레트 외 의미색 {measured} 사용", "recommendation": "검증 팔레트 색으로 교체하거나 대비율 검증 후 팔레트에 등재하십시오.", "ref": "§3.2.1" },

    { "id": "C2-01", "category": "C2", "appliesTo": "Both", "severity": "Major",
      "title": "최소 폰트 크기", "check": "minFontSize",
