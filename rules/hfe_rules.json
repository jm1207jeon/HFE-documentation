    { "id": "C2-05", "category": "C2", "appliesTo": "Both", "severity": "Minor",
      "title": "이탤릭·밑줄 강조 금지", "check": "forbiddenEmphasis",
      "params": { "forbidItalic": true, "underlineOnlyForLinks": true },
