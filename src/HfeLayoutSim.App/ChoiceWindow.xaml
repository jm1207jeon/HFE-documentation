<Window x:Class="HfeLayoutSim.App.ChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, RelativeSource={RelativeSource Self}}"
        SizeToContent="WidthAndHeight" MinWidth="430" MaxWidth="620"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontSize="13" FontFamily="Segoe UI, Malgun Gothic"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WhiteBrush}">
    <!--
        Replaces MessageBox for choices: the buttons state the action ("종이 양식 (A4) 생성") instead
        of a bare 예/아니오, which the app's own C8-06 rule forbids and which forces the user to
        re-read the prose to find out what "예" would do.
    -->
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ThirdButton" Style="{StaticResource ToolbarButton}" Click="OnThird"
                    MinWidth="132" Visibility="Collapsed" />
            <Button x:Name="SecondButton" Style="{StaticResource ToolbarButton}" Click="OnSecond"
                    MinWidth="132" />
            <Button x:Name="FirstButton" Style="{StaticResource PrimaryButton}" Click="OnFirst"
                    Margin="0" MinWidth="132" />
        </StackPanel>
    </StackPanel>
</Window>
