<Window x:Class="HfeLayoutSim.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:HfeLayoutSim.App"
        xmlns:vm="clr-namespace:HfeLayoutSim.App.ViewModels"
        Title="{Binding WindowTitle}"
        Width="1420" Height="920"
        WindowStartupLocation="CenterScreen"
        Background="#F1F3F5">

    <Window.Resources>
        <app:HexBrushConverter x:Key="HexBrush" />
        <app:BoolToFontWeightConverter x:Key="BoldWeight" />
        <app:AdviceLevelToGlyphConverter x:Key="AdviceGlyph" />
        <app:AdviceLevelToBrushConverter x:Key="AdviceBrush" />
        <app:PassToBrushConverter x:Key="PassBrush" />
        <app:NotNullConverter x:Key="NotNull" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════ toolbar ═══════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="새 양식 (Paper)" Command="{Binding NewPaperCommand}" Margin="0,0,6,0" Padding="10,6" />
                    <Button Content="새 화면 (Screen)" Command="{Binding NewScreenCommand}" Margin="0,0,12,0" Padding="10,6" />
                    <Button Content="열기…" Click="OnOpenClick" Margin="0,0,6,0" Padding="10,6" />
                    <Button Content="저장…" Click="OnSaveClick" Margin="0,0,12,0" Padding="10,6"
                            IsEnabled="{Binding HasLayout}" />
                    <Button Content="카탈로그로 생성…" Click="OnGenerateClick" Margin="0,0,12,0" Padding="10,6" />
                    <CheckBox Content="구역 오버레이 (POA/SFA/WFA/TA)" IsChecked="{Binding ShowZones}"
                              VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="확대" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#495057" />
                    <Slider Width="110" Minimum="0.4" Maximum="2.5" Value="{Binding Zoom}"
                            VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="HTML 리포트…" Click="OnExportHtmlClick" Margin="0,0,8,0" Padding="10,6"
                            IsEnabled="{Binding Report, Converter={StaticResource NotNull}}" />
                    <Button Content="평가 실행" Command="{Binding EvaluateCommand}" Padding="16,6"
                            Background="#1565C0" Foreground="White" FontWeight="Bold"
                            IsEnabled="{Binding HasLayout}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════ main area ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- palette -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="요소 팔레트 (더블클릭 = 배치)"
                               FontWeight="Bold" Margin="10,10,10,6" Foreground="#0D47A1" />
                    <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteItems}"
                             BorderThickness="0" MouseDoubleClick="OnPaletteDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Guidance}" TextWrapping="Wrap"
                                               FontSize="10.5" Foreground="#495057" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- canvas -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="#E9ECEF" Padding="24">
                <Grid x:Name="EditorRoot"
                      Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}"
                      Background="White"
                      Visibility="{Binding HasLayout, Converter={StaticResource BoolVis}}"
                      MouseLeftButtonDown="OnCanvasMouseDown"
                      MouseMove="OnCanvasMouseMove"
                      MouseLeftButtonUp="OnCanvasMouseUp">
                    <Grid.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                    </Grid.LayoutTransform>

                    <!-- zone overlay -->
                    <ItemsControl ItemsSource="{Binding ZoneOverlays}" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding W}" Height="{Binding H}">
                                    <Rectangle Fill="{Binding Fill, Converter={StaticResource HexBrush}}" />
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Opacity="0.5" FontWeight="Bold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- elements -->
                    <ItemsControl ItemsSource="{Binding Elements}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{Binding W}" Height="{Binding H}"
                                        Background="{Binding FillColor, Converter={StaticResource HexBrush}}"
                                        ToolTip="{Binding Tooltip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="{Binding StrokeColor, Converter={StaticResource HexBrush}}" />
                                            <Setter Property="BorderThickness" Value="0.6" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#1565C0" />
                                                    <Setter Property="BorderThickness" Value="1.4" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#C62828" />
                                                    <Setter Property="BorderThickness" Value="1.8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DisplayText}"
                                               FontSize="{Binding DisplayFontSize}"
                                               FontWeight="{Binding IsBold, Converter={StaticResource BoldWeight}}"
                                               Foreground="{Binding TextColor, Converter={StaticResource HexBrush}}"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               Margin="1" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- right panel -->
            <Border Grid.Column="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="1,0,0,0">
                <TabControl BorderThickness="0">

                    <TabItem Header="코칭">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Margin="8"
                                       Text="요소를 배치/이동/선택하면 위치·색상·폰트·크기·순서 진단이 표시됩니다."
                                       TextWrapping="Wrap" Foreground="#495057" FontSize="11" />
                            <ListBox ItemsSource="{Binding Advice}" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="4,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Level, Converter={StaticResource AdviceGlyph}}"
                                                               Foreground="{Binding Level, Converter={StaticResource AdviceBrush}}"
                                                               FontWeight="Bold" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Topic}" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding RuleId}" Foreground="#868E96" FontFamily="Consolas" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="18,2,0,0" />
                                                <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Margin="18,2,0,0"
                                                           Foreground="#1565C0" FontSize="11.5" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="속성">
                        <StackPanel Margin="10" IsEnabled="{Binding SelectedElement, Converter={StaticResource NotNull}}">
                            <TextBlock Text="{Binding SelectedElement.Tooltip}" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="문구 (Text)" Foreground="#495057" FontSize="11" />
                            <TextBox Text="{Binding SelectedElement.Text, UpdateSourceTrigger=LostFocus}" Margin="0,2,0,8" />
                            <UniformGrid Columns="2" Rows="2">
                                <StackPanel Margin="0,0,6,6">
                                    <TextBlock Text="X" Foreground="#495057" FontSize="11" />
                                    <TextBox Text="{Binding SelectedElement.X, StringFormat=0.#}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Y" Foreground="#495057" FontSize="11" />
                                    <TextBox Text="{Binding SelectedElement.Y, StringFormat=0.#}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="너비 (W)" Foreground="#495057" FontSize="11" />
                                    <TextBox Text="{Binding SelectedElement.W, StringFormat=0.#}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="높이 (H)" Foreground="#495057" FontSize="11" />
                                    <TextBox Text="{Binding SelectedElement.H, StringFormat=0.#}" />
                                </StackPanel>
                            </UniformGrid>
                            <Button Content="선택 요소 삭제" Command="{Binding DeleteSelectedCommand}"
                                    Margin="0,12,0,0" Padding="8,5" HorizontalAlignment="Left"
                                    Foreground="#C62828" BorderBrush="#C62828" Background="White" />
                            <TextBlock Text="단위: Paper=mm, Screen=px. 값 수정 후 다른 곳을 클릭하면 반영됩니다."
                                       TextWrapping="Wrap" Foreground="#868E96" FontSize="10.5" Margin="0,10,0,0" />
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="리포트">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" CornerRadius="6" Margin="8" Padding="10"
                                    Background="{Binding VerdictPass, Converter={StaticResource PassBrush}}"
                                    Visibility="{Binding Report, Converter={StaticResource NotNull}, FallbackValue=Collapsed}">
                                <StackPanel>
                                    <TextBlock Text="{Binding VerdictText}" FontSize="22" FontWeight="Bold" />
                                    <TextBlock Text="{Binding VerdictDetail}" TextWrapping="Wrap" FontSize="12" />
                                    <ItemsControl ItemsSource="{Binding CategoryGrades}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#868E96" BorderThickness="1" CornerRadius="3"
                                                        Padding="4,1" Margin="0,0,4,4" Background="White">
                                                    <TextBlock Text="{Binding Summary}" FontFamily="Consolas" FontSize="11" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Top" Margin="8,0,8,4" Foreground="#495057" FontSize="11"
                                       Text="지적을 클릭하면 캔버스에서 해당 요소가 붉게 표시됩니다." />
                            <ListBox x:Name="FindingsList" ItemsSource="{Binding Findings}" BorderThickness="0"
                                     SelectionChanged="OnFindingSelected"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="4,6">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Severity}" FontWeight="Bold"
                                                               Foreground="#C62828" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding RuleId}" FontFamily="Consolas"
                                                               Foreground="#868E96" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap"
                                                           Foreground="#1565C0" FontSize="11.5" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding StandardRef}" Foreground="#868E96"
                                                           FontSize="10.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>

        <!-- ═══════════ status bar ═══════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DEE2E6" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock Text="{Binding StatusText}" Foreground="#495057" />
        </Border>
    </Grid>
</Window>
