<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- allows compiling this Windows app from non-Windows build machines -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>HfeLayoutSim</AssemblyName>
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HfeLayoutSim.Core\HfeLayoutSim.Core.csproj" />
  </ItemGroup>

  <!-- Knowledge base, presets, catalogs and samples travel next to the exe so a QC manager can
       edit thresholds without rebuilding. -->
  <ItemGroup>
    <Content Include="..\..\rules\hfe_rules.json" Link="rules\hfe_rules.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\rules\element_presets.json" Link="rules\element_presets.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\catalog\*.catalog.json" LinkBase="catalog" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\*.hfelayout.json" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ...and are ALSO embedded, so an exe copied out of the zip on its own still starts. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\rules\hfe_rules.json" LogicalName="HfeLayoutSim.Embedded.rules.hfe_rules.json" />
    <EmbeddedResource Include="..\..\rules\element_presets.json" LogicalName="HfeLayoutSim.Embedded.rules.element_presets.json" />
  </ItemGroup>

</Project>
