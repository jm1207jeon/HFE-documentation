<Window x:Class="HfeLayoutSim.App.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:HfeLayoutSim.App"
        Title="{Binding Title}"
        Width="1080" Height="780" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontSize="13" FontFamily="Segoe UI, Malgun Gothic"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>
        <app:HexBrushConverter x:Key="HexBrush" />
        <app:NonEmptyToVisibilityConverter x:Key="NonEmptyVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InverseBoolVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource WhiteBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Text="{Binding Summary}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button DockPanel.Dock="Right" Content="비교 창 닫기" Style="{StaticResource ToolbarButton}"
                        IsCancel="True" Margin="0" Click="OnClose" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
            <StackPanel>
                <!-- verdict cards -->
                <ItemsControl ItemsSource="{Binding Variants}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" Margin="0,0,10,0"
                                    Padding="14,12" BorderThickness="2"
                                    BorderBrush="{Binding AccentHex, Converter={StaticResource HexBrush}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Verdict}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{Binding VerdictHex, Converter={StaticResource HexBrush}}" />
                                        <TextBlock Text="{Binding GradeLabel}" FontSize="24" FontWeight="Bold"
                                                   Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding ScoreLabel}" FontSize="18" VerticalAlignment="Bottom"
                                                   Margin="10,0,0,2" Foreground="{StaticResource TextSubBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding FindingLabel}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding CapNote}" Foreground="{StaticResource FailBrush}"
                                               FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding CapNote, Converter={StaticResource NonEmptyVis}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- category scores -->
                <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" Padding="14" Margin="0,14,10,0">
                    <StackPanel>
                        <TextBlock Text="카테고리별 점수" Style="{StaticResource SectionHeading}" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="카테고리" FontWeight="Bold" />
                            <TextBlock Grid.Column="1" Text="{Binding Variant0Name}" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="{Binding Variant1Name}" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding Variant2Name}" FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" TextAlignment="Right"
                                       Visibility="{Binding HasThirdVariant, Converter={StaticResource BoolVis}}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource MonoText}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Score0}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding Score1}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Text="{Binding Score2}" TextAlignment="Right"
                                                   Visibility="{Binding HasThird, Converter={StaticResource BoolVis}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- rule-level diff -->
                <ItemsControl ItemsSource="{Binding DiffGroups}" Margin="0,14,10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource WhiteBrush}" CornerRadius="6" Padding="14"
                                    Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" FontWeight="Bold" TextWrapping="Wrap"
                                               Foreground="{Binding Hex, Converter={StaticResource HexBrush}}" />
                                    <TextBlock Text="{Binding EmptyNote}" Style="{StaticResource HintText}"
                                               Margin="0,6,0,0"
                                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />
                                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding SeverityLabel}" FontWeight="Bold"
                                                               MinWidth="56" Margin="0,0,8,0"
                                                               Foreground="{Binding SeverityHex, Converter={StaticResource HexBrush}}" />
                                                    <TextBlock Text="{Binding RuleId}" Style="{StaticResource MonoText}"
                                                               MinWidth="58" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
